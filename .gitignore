# =============================================================================
# Secrets & credentials — never commit the real files. Only `.example.*` ships.
# =============================================================================
.env
.env.local
.env.*.local

# Telethon authentication sessions (full Telegram-account takeover material)
*.session
*.session-journal

# Real runtime configs (templates ship as `*.example.*`)
config.py
openclaw.json
**/auth-profiles.json
**/auth-state.json
cron/jobs.json
cron/jobs-state.json

# Identity material — Ed25519 keypair lives here at run-time
identity/device.json
identity/device-auth.json

# Pairing material — operator tokens for paired devices
devices/paired.json
devices/pending.json
!devices/*.example.json

# Credential vaults — bot allowlists, deep-link pairing handshakes
credentials/*
!credentials/*.example.json

# Telegram channel-state markers
telegram/*.json
!telegram/*.example.json

# =============================================================================
# Runtime state — auto-created by the OpenClaw gateway / cron / agent
# =============================================================================
# SQLite stores
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
learning.db

# Per-skill state
**/trade_history/
**/models/*.pkl

# Agent runtime
agents/main/sessions/
agents/main/agent/auth-state.json

# Scheduler history
cron/runs/

# Gateway state
flows/*
!flows/.gitkeep
tasks/*
!tasks/.gitkeep
memory/*
!memory/.gitkeep
logs/*
!logs/.gitkeep

# Generated plugin manifests
plugins/installs.json
plugin-skills/

# Mutable status files
exec-approvals.json
update-check.json
gateway-restart.log
gateway-restart-intent.json
userbot.log

# =============================================================================
# Logs & backups
# =============================================================================
*.log
*.bak
*.bak.*
*.last-good
*.clobbered.*

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# =============================================================================
# Node / npm
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# =============================================================================
# IDE / OS
# =============================================================================
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# OpenClaw / Claude Code harness
# =============================================================================
.claude/
canvas/
completions/
workspace/state/
