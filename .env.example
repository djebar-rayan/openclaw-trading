# =============================================================================
# OpenClaw Trading — environment template
# Copy this file to `.env` and fill every value below.
# Never commit your real `.env` to git; `.gitignore` already excludes it.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram user-bot (Telethon, MTProto)
# Acquire api_id + api_hash at: https://my.telegram.org -> API development tools
# -----------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# -----------------------------------------------------------------------------
# Telegram bot (Bot API — for outbound notifications & fast-path replies)
# Create with @BotFather and copy the token here.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Owner chat id that receives bilingual confirmation messages.
TELEGRAM_OWNER_CHAT_ID=123456789

# Comma-separated list of Telegram user IDs allowed to send signals to the
# fast-path bot. Everything else is dropped.
FASTPATH_ALLOWED_SENDERS=123456789

# Optional fast-path overrides. If unset, the fast-path bot reuses
# TELEGRAM_BOT_TOKEN above and the daily-report script reuses
# TELEGRAM_OWNER_CHAT_ID. Set these only if you want a separate bot or
# a different chat for daily reports.
FASTPATH_BOT_TOKEN=
REPORT_CHAT_ID=

# Set to "0" to disable the LLM fallback path (parser-only mode).
FASTPATH_LLM_FALLBACK=1

# Agent id the fast-path bot routes unmatched signals to.
FASTPATH_OPENCLAW_AGENT=main

# Regex; signals whose text matches bypass the three safety checks.
# Use sparingly — only for sources with a proven track record.
FASTPATH_TRUSTED_SOURCES=

# Signal-source channels the dual-listener subscribes to.
# Format: "<channel_id>:<display_name>,<channel_id>:<display_name>,..."
# Example: "-1001234567890:Signal Channel A,-1009876543210:Signal Channel B"
TELEGRAM_LISTENER_A_CHANNELS=
TELEGRAM_LISTENER_B_CHANNELS=

# Telethon session file names (created on first OTP login).
TELETHON_SESSION_A=session_listener_a
TELETHON_SESSION_B=session_listener_b

# OpenClaw inbox: the bot username your signals are forwarded to.
OPENCLAW_INBOX_BOT=@your_openclaw_inbox_bot

# -----------------------------------------------------------------------------
# MetaTrader 5
# Get these from your broker's client area. Strongly recommended: start on a
# demo server (e.g. "MetaQuotes-Demo") and switch to live only after backtest.
# -----------------------------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo
MT5_SYMBOL=XAUUSD

# -----------------------------------------------------------------------------
# Model provider — NVIDIA-hosted Mistral via OpenAI-compatible API
# Get a key at: https://build.nvidia.com (NIM API)
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key

# -----------------------------------------------------------------------------
# OpenClaw gateway (loopback only — never expose to the public internet)
# Generate a strong token:  python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
GATEWAY_AUTH_TOKEN=generate_a_64_char_hex_token
GATEWAY_PORT=18789

# -----------------------------------------------------------------------------
# Risk knobs (defaults live in mt5-trading-assistant/risk_config.json).
# Volume must stay at 0.05 — every script forces it back if you pass anything else.
# -----------------------------------------------------------------------------
VOLUME_PER_TRADE=0.05
