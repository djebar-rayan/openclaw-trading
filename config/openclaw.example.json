{
  "_comment": "OpenClaw gateway + agent config template. Copy to openclaw.json and replace every 'your_*' placeholder. Real openclaw.json is gitignored.",
  "gateway": {
    "auth": {
      "mode": "token",
      "token": "your_gateway_auth_token"
    },
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "botToken": "your_telegram_bot_token",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "123456789"
      ],
      "groupAllowFrom": [
        "*"
      ],
      "network": {
        "dnsResultOrder": "ipv4first"
      },
      "streaming": {
        "mode": "off"
      },
      "ackReaction": ""
    }
  },
  "agents": {
    "defaults": {
      "models": {
        "mistralai/mistral-medium-3.5-128b": {
          "alias": "Mistral"
        }
      },
      "model": {
        "primary": "mistralai/mistral-medium-3.5-128b"
      },
      "thinkingDefault": "off"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "mistralai": {
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "mistralai/mistral-medium-3.5-128b",
            "name": "Mistral Medium 3.5 128B",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 16384,
            "compat": {
              "requiresStringContent": true
            }
          }
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "mistralai:default": {
        "provider": "mistralai",
        "mode": "api_key"
      }
    }
  },
  "plugins": {
    "entries": {
      "nvidia": {
        "enabled": true
      },
      "telegram": {
        "enabled": false
      }
    }
  },
  "commands": {
    "ownerAllowFrom": [
      "telegram:123456789"
    ]
  }
}
